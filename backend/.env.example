# Backend only. Never copy database credentials into frontend configuration.
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgress_url
MONGODB_URI=mong0_url
MONGODB_DB=gigtask_db
# Set verify-full for a cloud provider that requires TLS; provide its CA if needed.
# A provider URL containing sslmode=require/verify-full is also supported by pg.
PG_SSL_MODE=url
# PG_SSL_CA_FILE=/absolute/path/provider-ca.pem
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
