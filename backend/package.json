{
  "name": "gigtask-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "seed:linked": "node --env-file-if-exists=.env scripts/seed-linked.js",
    "refresh:pings": "node --env-file-if-exists=.env scripts/seed-linked.js --pings-only",
    "test": "node --test test/*.test.js",
    "reset:demo": "node --env-file-if-exists=.env scripts/reset-demo.js --confirm-gigtask-reset",
    "seed:scale": "node --env-file-if-exists=.env scripts/seed-scale.js --replace-gigtask-data",
    "audit:scale": "node --env-file-if-exists=.env scripts/audit-scale.js"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "mongodb": "^6.20.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
